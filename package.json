{
  "name": "pixel-perfect",
  "version": "0.10.0",
  "description": "A component library with opinions.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.mts",
      "default": "./dist/theme/index.mjs"
    },
    "./styles.css": "./dist/pixel-perfect.css"
  },
  "bin": {
    "pixel-perfect": "./dist/theme/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:js && npm run build:css && npm run build:agents",
    "build:js": "tsc -p tsconfig.build.json",
    "build:css": "lightningcss --bundle --targets 'defaults' src/styles/index.css -o dist/pixel-perfect.css",
    "build:agents": "node scripts/build-agent-docs.mjs",
    "prepare": "npm run build",
    "tokens": "node scripts/generate-tokens.mjs",
    "dimensions": "node scripts/record-dimensions.mjs",
    "decisions": "node scripts/decisions-index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "lint": "npm run lint:css && npm run lint:rules && npm run lint:contrast && npm run lint:self-test",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:rules": "node scripts/lint-rules.mjs",
    "lint:contrast": "node scripts/check-contrast.mjs",
    "lint:self-test": "node scripts/test-lint.mjs",
    "dev": "npm run build && npm --prefix playground run dev",
    "playground:install": "npm --prefix playground install",
    "playground:build": "npm --prefix playground run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript/typescript6": "^6.0.2",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.2",
    "lightningcss-cli": "^1.30.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stylelint": "^17.16.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.21",
    "@radix-ui/react-alert-dialog": "^1.1.24",
    "@radix-ui/react-context-menu": "^2.3.8",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-toast": "^1.2.24",
    "@radix-ui/react-tooltip": "^1.3.0"
  }
}
