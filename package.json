{
  "name": "pixel-perfect",
  "version": "0.5.0",
  "description": "A component library with opinions.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/pixel-perfect.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:js && npm run build:css",
    "build:js": "tsc -p tsconfig.build.json",
    "build:css": "lightningcss --bundle --targets 'defaults' src/styles/index.css -o dist/pixel-perfect.css",
    "prepare": "npm run build",
    "tokens": "node scripts/generate-tokens.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "lint": "npm run lint:css && npm run lint:rules && npm run lint:contrast && npm run lint:self-test",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:rules": "node scripts/lint-rules.mjs",
    "lint:contrast": "node scripts/check-contrast.mjs",
    "lint:self-test": "node scripts/test-lint.mjs",
    "dev": "npm run build && npm --prefix playground run dev",
    "playground:install": "npm --prefix playground install",
    "playground:build": "npm --prefix playground run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.1",
    "lightningcss-cli": "^1.30.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stylelint": "^16.0.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
